#!/usr/bin/env bash
# Foamy launcher IPC. Installation and keybindings stay with Omarchy and dotfiles.
set -euo pipefail
case "${1:-}" in
  toggle | show | hide | ping | isOpen | run | call)
    exec omarchy-shell foamy-menu "$@"
    ;;
  build-search)
    exec "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/build-search" "${@:2}"
    ;;
  *)
    echo 'Usage: foamy-menu toggle|show|hide|ping|isOpen|run <id>|call <method> [json]|build-search [--verify|--test]' >&2
    exit 2
    ;;
esac
